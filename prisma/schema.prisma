// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  admin
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String
  passwordHash String?
  role         Role     @default(user)
  googleSub    String?  @unique
  linkedinId   String?  @unique
  picture      String?
  createdAt    DateTime @default(now())

  fields         String  @default("[]") // JSON string[] — job-search focus areas
  experience     String? // experience bracket key
  title          String?
  location       String?
  linkedinSynced Boolean @default(true)
  mailSynced     Boolean @default(true)

  goalApps  Int     @default(5)
  goalMocks Int     @default(2)
  goalDate  String?

  trialStartedAt DateTime @default(now())
  subscribed     Boolean  @default(false)
  billingPlan    String? // "card" | "paypal" | "applepay" | "googlepay"

  sessions       Session[]
  resetTokens    PasswordResetToken[]
  applications   Application[]
  profileLinks   ProfileLink[]
  stages         PipelineStage[]
  cvLibraryItems CvLibraryItem[]
  files          StoredFile[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Application {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  company     String
  role        String
  source      String      @default("Direct")
  cvVersion   String?
  cvFileName  String?
  cvFileId    String? // the actual CV file sent with this application
  cvFile      StoredFile? @relation("ApplicationCv", fields: [cvFileId], references: [id], onDelete: SetNull)
  link        String?
  appliedDate String
  stage       String      @default("applied")
  nextStep    String      @default("Awaiting response")
  desc        String?
  referral    Boolean     @default(false)
  rejected    Boolean     @default(false)
  rejectedAt  String?

  assignmentTitle String?
  assignmentDesc  String?
  assignmentDue   String?

  jdKeywords String @default("[]") // JSON string[]
  notes      String @default("[]") // JSON {date, text, stage?}[]

  emails          StageEmail[]
  assignmentFiles AssignmentFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Uploaded file bytes (CVs, emails, assignment briefs/submissions). Stored in Postgres so no
/// separate object-storage service is needed; uploads are capped well below the serverless
/// request-body limit (see src/lib/files.ts). Served only to the owning user via /api/files/[id].
model StoredFile {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  emails          StageEmail[]
  assignmentFiles AssignmentFile[]
  cvApplications  Application[]    @relation("ApplicationCv")
  libraryItems    CvLibraryItem[]  @relation("LibraryCv")

  @@index([userId])
}

/// An email attached to (or pasted into) one stage of an application's history.
model StageEmail {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stageKey      String
  fileId        String?
  file          StoredFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  name          String // display name (file name, or the subject for pasted text)
  subject       String?
  sender        String?
  body          String? // pasted email text, when no file was attached
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

/// Home Assignment files: the brief you were given, and your submission.
model AssignmentFile {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  slot          String // "brief" | "submission"
  fileId        String
  file          StoredFile  @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

model ProfileLink {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  label  String
  url    String

  @@index([userId])
}

model PipelineStage {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  key      String
  label    String
  desc     String?
  color    String
  soft     String
  position Int
  custom   Boolean @default(false)

  @@unique([userId, key])
  @@index([userId])
}

model CvLibraryItem {
  id     String      @id @default(cuid())
  userId String
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String
  date   String
  tag    String
  fileId String? // set when the CV was uploaded as a real file
  file   StoredFile? @relation("LibraryCv", fields: [fileId], references: [id], onDelete: SetNull)

  @@index([userId])
}
